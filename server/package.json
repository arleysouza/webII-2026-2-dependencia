{
  "name": "app-exemplo",
  "version": "1.0.0",
  "private": true,
  "description": "API Express e PostgreSQL com injeção de dependência.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=../.env dist/main.js",
    "dev": "node --env-file=../.env --import tsx --watch src/main.ts",
    "start:prod": "node --env-file=../.env dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
